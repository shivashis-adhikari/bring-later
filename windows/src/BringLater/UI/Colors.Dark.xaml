<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Neutrals follow Windows 11's dark theme. The accent is the logo's light tint, with the
       wordmark's navy for text on it, the same way Windows pairs a light accent with dark text. -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2B2B" />
  <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#404040" />
  <SolidColorBrush x:Key="CardBrush" Color="#2B2B2B" />
  <SolidColorBrush x:Key="CardStrokeBrush" Color="#1C1C1C" />
  <SolidColorBrush x:Key="DividerBrush" Color="#3A3A3A" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C7C7C7" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9B9B9B" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="#717171" />
  <SolidColorBrush x:Key="CriticalBrush" Color="#FF99A4" />

  <SolidColorBrush x:Key="AccentBrush" Color="#99C0FD" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#A9CAFD" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#88B2F4" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="#0B1843" />
  <SolidColorBrush x:Key="AccentDisabledBrush" Color="#434343" />
  <SolidColorBrush x:Key="AccentTintBrush" Color="#26324A" />

  <SolidColorBrush x:Key="ControlBrush" Color="#2D2D2D" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#323232" />
  <SolidColorBrush x:Key="ControlPressedBrush" Color="#282828" />
  <SolidColorBrush x:Key="ControlStrokeBrush" Color="#363636" />
  <SolidColorBrush x:Key="ControlStrokeBottomBrush" Color="#2A2A2A" />

  <SolidColorBrush x:Key="InputBrush" Color="#2D2D2D" />
  <SolidColorBrush x:Key="InputFocusedBrush" Color="#1F1F1F" />
  <SolidColorBrush x:Key="InputStrokeBrush" Color="#363636" />
  <SolidColorBrush x:Key="InputBottomBrush" Color="#9B9B9B" />

  <SolidColorBrush x:Key="SubtleHoverBrush" Color="#10FFFFFF" />
  <SolidColorBrush x:Key="SubtlePressedBrush" Color="#0AFFFFFF" />
  <SolidColorBrush x:Key="SelectedBrush" Color="#26324A" />

  <SolidColorBrush x:Key="KeycapBrush" Color="#343434" />
  <SolidColorBrush x:Key="KeycapStrokeBrush" Color="#474747" />
  <SolidColorBrush x:Key="KeycapShadowBrush" Color="#1C1C1C" />

  <SolidColorBrush x:Key="ToggleOffStrokeBrush" Color="#9B9B9B" />
  <SolidColorBrush x:Key="ToggleOffKnobBrush" Color="#C7C7C7" />
  <SolidColorBrush x:Key="ToggleOnKnobBrush" Color="#0B1843" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#8C8C8C" />

  <SolidColorBrush x:Key="FocusOuterBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FocusInnerBrush" Color="#000000" />

  <Color x:Key="ShadowColor">#000000</Color>
  <Color x:Key="CaptionColor">#202020</Color>
  <sys:Double x:Key="ShadowOpacity">0.42</sys:Double>
</ResourceDictionary>
