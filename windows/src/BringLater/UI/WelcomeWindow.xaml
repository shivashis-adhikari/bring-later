<Window x:Class="BringLater.UI.WelcomeWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bring Later"
        Width="500"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">
  <StackPanel Margin="32,28,32,24">
    <Image Source="{StaticResource LogoMark}" Width="52" Height="52" HorizontalAlignment="Left" />
    <TextBlock Text="Bring Later is running" Style="{StaticResource Text.Subtitle}" Margin="0,18,0,10" />

    <WrapPanel>
      <TextBlock Text="Press" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ItemsControl x:Name="Keys" Focusable="False" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Keycap}">
              <TextBlock Text="{Binding}" Style="{StaticResource KeycapText}" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="on any window, pick a time, and it's gone until then." Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="None" />
    </WrapPanel>

    <TextBlock Style="{StaticResource Text.Paragraph}" Margin="0,14,0,0"
               Text="Everything you've snoozed is in the notification area. If you don't see the icon, select Show hidden icons on the taskbar." />

    <Border Style="{StaticResource Card}" Margin="0,22,0,0" MinHeight="0" Padding="16,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="Start with Windows" Style="{StaticResource Text}" />
          <TextBlock Text="Bring Later has to be running to bring windows back." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None" />
        </StackPanel>
        <CheckBox x:Name="StartToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="True" VerticalAlignment="Center"
                  AutomationProperties.Name="Start with Windows" />
      </Grid>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="Settings" Style="{StaticResource Button.Standard}" Margin="0,0,8,0" Click="OnSettings" />
      <Button Content="Done" Style="{StaticResource Button.Accent}" IsDefault="True" Click="OnDone" />
    </StackPanel>
  </StackPanel>
</Window>
