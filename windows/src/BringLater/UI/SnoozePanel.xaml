<Window x:Class="BringLater.UI.SnoozePanel" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bring Later"
        Style="{StaticResource PopupWindow}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <!-- One row in the preset list. Keyboard selection and hover share the Windows list look. -->
    <Style x:Key="PresetRow" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Height="36" CornerRadius="4" Padding="12,0" Background="Transparent">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
              </Trigger>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectedBrush}" />
              </DataTrigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DayButton" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" CornerRadius="18" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
              <TextBlock x:Name="Label" Text="{Binding Label}" Style="{StaticResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding InMonth}" Value="False">
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsToday}" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
              </Trigger>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                <Setter TargetName="Root" Property="Background" Value="Transparent" />
                <Setter Property="IsHitTestVisible" Value="False" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <ContentControl Style="{StaticResource PopupCard}">
    <StackPanel Width="392" Margin="16,16,16,12">

      <!-- Which window this is about -->
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
          <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"
                 Visibility="{Binding HasIcon, Converter={StaticResource Visible}}" />
          <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource TextSecondaryBrush}"
                     Visibility="{Binding IsRefused, Converter={StaticResource Visible}}" />
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Strong}" />
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" Margin="0,1,0,0" />
        </StackPanel>
      </Grid>

      <!-- Why it can't be snoozed -->
      <StackPanel Visibility="{Binding IsRefused, Converter={StaticResource Visible}}">
        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Paragraph}" Margin="0,0,0,16" />
        <Button Content="Close" Style="{StaticResource Button.Standard}" HorizontalAlignment="Right" Click="OnClose" />
      </StackPanel>

      <!-- Typed time -->
      <TextBox x:Name="Input" Style="{StaticResource InputBox}" Tag="{Binding Placeholder}"
               Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
               Visibility="{Binding ShowInput, Converter={StaticResource Visible}}"
               AutomationProperties.Name="Time to bring the window back" />

      <Grid Height="36" Margin="0,6,0,0" Visibility="{Binding ShowResult, Converter={StaticResource Visible}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2" CornerRadius="4">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                  <Setter Property="Background" Value="Transparent" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
        </Border>
        <TextBlock Text="{Binding Result}" Margin="12,0" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Text}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Border Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Keycap}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="Enter" Style="{StaticResource KeycapText}" />
        </Border>
      </Grid>

      <!-- Presets -->
      <ItemsControl ItemsSource="{Binding Rows}" Margin="-4,6,-4,0" Visibility="{Binding ShowPresets, Converter={StaticResource Visible}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource PresetRow}" Click="OnPresetClick" Margin="0,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Text}" />
                <TextBlock Grid.Column="1" Text="{Binding Time}" Style="{StaticResource Text.Secondary}" Margin="12,0,0,0" />
                <TextBlock Grid.Column="2" Text="{Binding Shortcut}" Style="{StaticResource Text.Tertiary}" HorizontalAlignment="Right" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Date and time picker -->
      <StackPanel Visibility="{Binding IsPicking, Converter={StaticResource Visible}}">
        <Grid Margin="-6,-4,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Content="&#xE72B;" Style="{StaticResource Button.Icon}" Click="OnBack" ToolTip="Back" AutomationProperties.Name="Back" />
          <TextBlock Grid.Column="1" Text="{Binding MonthTitle}" Style="{StaticResource Text.Strong}" VerticalAlignment="Center" Margin="4,0,0,0" />
          <Button Grid.Column="2" Content="&#xE76B;" Style="{StaticResource Button.Icon}" FontSize="12" Click="OnPreviousMonth"
                  IsEnabled="{Binding CanGoBack}" ToolTip="Previous month" AutomationProperties.Name="Previous month" />
          <Button Grid.Column="3" Content="&#xE76C;" Style="{StaticResource Button.Icon}" FontSize="12" Click="OnNextMonth"
                  IsEnabled="{Binding CanGoForward}" ToolTip="Next month" AutomationProperties.Name="Next month" />
        </Grid>

        <ItemsControl ItemsSource="{Binding WeekdayHeaders}" HorizontalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="7" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Style="{StaticResource Text.Tertiary}" Width="40" TextAlignment="Center" Margin="0,0,0,4" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Days}" HorizontalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="7" Rows="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource DayButton}" Click="OnDayClick" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="TimeInput" Style="{StaticResource InputBox}" Text="{Binding PickedTime, UpdateSourceTrigger=PropertyChanged}"
                   Width="140" HorizontalAlignment="Left" AutomationProperties.Name="Time" />
          <Button Grid.Column="1" Content="Snooze" Style="{StaticResource Button.Accent}" IsEnabled="{Binding CanPick}" Click="OnPickConfirm" />
        </Grid>
        <TextBlock Text="{Binding PickResult}" Margin="0,8,0,2">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding PickIsError}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>

      <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Paragraph}" Foreground="{DynamicResource CriticalBrush}"
                 Margin="0,10,0,2" Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
    </StackPanel>
  </ContentControl>
</Window>
