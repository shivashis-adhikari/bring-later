<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Neutrals follow Windows 11's light theme. The accent is the logo's clock blue. -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FAFAFA" />
  <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#DEDEDE" />
  <SolidColorBrush x:Key="CardBrush" Color="#FBFBFB" />
  <SolidColorBrush x:Key="CardStrokeBrush" Color="#E5E5E5" />
  <SolidColorBrush x:Key="DividerBrush" Color="#E8E8E8" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F5F5F" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A8A8A" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="#A3A3A3" />
  <SolidColorBrush x:Key="CriticalBrush" Color="#C42B1C" />

  <SolidColorBrush x:Key="AccentBrush" Color="#1A61F4" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#3071F5" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#4A82F6" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentDisabledBrush" Color="#C5C5C5" />
  <SolidColorBrush x:Key="AccentTintBrush" Color="#E7EFFE" />

  <SolidColorBrush x:Key="ControlBrush" Color="#FDFDFD" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#F6F6F6" />
  <SolidColorBrush x:Key="ControlPressedBrush" Color="#F1F1F1" />
  <SolidColorBrush x:Key="ControlStrokeBrush" Color="#E2E2E2" />
  <SolidColorBrush x:Key="ControlStrokeBottomBrush" Color="#CDCDCD" />

  <SolidColorBrush x:Key="InputBrush" Color="#FDFDFD" />
  <SolidColorBrush x:Key="InputFocusedBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="InputStrokeBrush" Color="#E2E2E2" />
  <SolidColorBrush x:Key="InputBottomBrush" Color="#8A8A8A" />

  <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0B000000" />
  <SolidColorBrush x:Key="SubtlePressedBrush" Color="#07000000" />
  <SolidColorBrush x:Key="SelectedBrush" Color="#E7EFFE" />

  <SolidColorBrush x:Key="KeycapBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="KeycapStrokeBrush" Color="#D9D9D9" />
  <SolidColorBrush x:Key="KeycapShadowBrush" Color="#C4C4C4" />

  <SolidColorBrush x:Key="ToggleOffStrokeBrush" Color="#8A8A8A" />
  <SolidColorBrush x:Key="ToggleOffKnobBrush" Color="#5F5F5F" />
  <SolidColorBrush x:Key="ToggleOnKnobBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#9A9A9A" />

  <SolidColorBrush x:Key="FocusOuterBrush" Color="#1B1B1B" />
  <SolidColorBrush x:Key="FocusInnerBrush" Color="#FFFFFF" />

  <Color x:Key="ShadowColor">#000000</Color>
  <Color x:Key="CaptionColor">#F3F3F3</Color>
  <sys:Double x:Key="ShadowOpacity">0.16</sys:Double>
</ResourceDictionary>
