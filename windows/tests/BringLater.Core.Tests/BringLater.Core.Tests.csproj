<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Test names read as sentences; CA1707 wants no underscores. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/BringLater.Core/BringLater.Core.csproj" />
    <None Include="../../../fixtures/*.json" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/BringLater/Locales/*.json" LinkBase="locales" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
