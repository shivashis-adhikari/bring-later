<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders the real WPF views with sample data to PNG, for the README, the website and review.
       Runs in CI on Windows, see .github/workflows/ci.yml. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <NoWarn>$(NoWarn);CA1303</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/BringLater/BringLater.csproj" />
  </ItemGroup>
</Project>
